---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { TOPICS } from '../../data/site';
import { getNotes, backlinks, related, fmtDate } from '../../lib/notes';

export async function getStaticPaths() {
  const all = await getNotes();
  return all.map((note) => ({ params: { id: note.id }, props: { note, all } }));
}
const { note, all } = Astro.props;
const { Content } = await render(note);
const back = backlinks(note, all);
const rel = related(note, all).filter((r) => !back.includes(r));
const topicTitle = (s: string) => TOPICS.find((t) => t.slug === s)?.title ?? s;
---
<Base title={note.data.title} description={note.data.description}>
  <p class="crumbs"><a href="/">← На главную</a></p>
  <article class="note">
    <h1>{note.data.title}</h1>
    <p class="muted">
      {fmtDate(note.data.date)}
      {note.data.topics.map((t) => <> · <a href={`/topics/${t}/`}>{topicTitle(t)}</a></>)}
    </p>
    <div class="prose"><Content /></div>
  </article>
  {back.length > 0 && (
    <section>
      <h2>Ссылаются сюда</h2>
      <ul class="notes">{back.map((n) => <li><a href={`/notes/${n.id}/`}>{n.data.title}</a></li>)}</ul>
    </section>
  )}
  {rel.length > 0 && (
    <section>
      <h2>Похожие заметки</h2>
      <ul class="notes">{rel.map((n) => <li><a href={`/notes/${n.id}/`}>{n.data.title}</a></li>)}</ul>
    </section>
  )}
</Base>
