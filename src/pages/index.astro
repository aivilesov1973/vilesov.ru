---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
---
<Base>
  <figure class="hero">
    <img
      src="/img/hero.webp"
      width="640"
      height="427"
      alt="Ночная набережная, на крыше здания светится надпись: кто мы, откуда, куда мы идём?"
    />
  </figure>

  <header class="intro">
    <h1>{SITE.title}</h1>
    <p class="lead">{SITE.lead}</p>
  </header>
</Base>
