---
import { fmtDate, type Note } from '../lib/notes';
interface Props { notes: Note[] }
const { notes } = Astro.props;
---
{notes.length === 0 ? <p class="muted">Пока пусто.</p> : (
  <ul class="notes">
    {notes.map((n) => (
      <li>
        <a href={`/notes/${n.id}/`}>{n.data.title}</a>
        <span class="muted"> · {fmtDate(n.data.date)}</span>
        {n.data.description && <p class="note-desc">{n.data.description}</p>}
      </li>
    ))}
  </ul>
)}
